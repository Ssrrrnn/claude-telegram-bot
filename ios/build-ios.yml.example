# Copy to .github/workflows/build-ios.yml ONLY in a separate public client repo.
# This guard prevents a build from consuming private-repository paid minutes.
name: Build personal iOS app
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  build:
    if: github.event.repository.private == false
    runs-on: macos-15
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v6
      - name: Install project generator
        run: brew install xcodegen
      - name: Build unsigned IPA
        run: bash ios/build.sh
      - uses: actions/upload-artifact@v6
        with:
          name: Companion-unsigned
          path: ios/build/Companion.ipa
          retention-days: 1
